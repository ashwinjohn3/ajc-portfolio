---
/**
 * Section — 1/3 label + 2/3 content split (collapses to single-column on mobile).
 *
 * Props:
 *   id       — rendered as the <section> id; used for scroll anchors
 *   label    — Space Mono section label (e.g. "experience", "tools")
 *   class    — forwarded to the outer <section> for responsive overrides
 *
 * Usage:
 *   <Section id="experience" label="experience">
 *     ... cards or any content ...
 *   </Section>
 */

interface Props {
  id: string;
  label: string;
  class?: string;
}

const { id, label, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'border-t border-border py-10',
    className,
  ]}
>
  <div class="flex flex-col gap-6 md:flex-row md:gap-10">
    <!-- 1/3 — section label (Space Mono, muted, uppercase tracking) -->
    <div class="md:w-1/3 shrink-0">
      <span class="font-mono text-xs uppercase tracking-widest text-secondary">
        {label}
      </span>
    </div>

    <!-- 2/3 — content slot -->
    <div class="md:w-2/3 min-w-0">
      <slot />
    </div>
  </div>
</section>
