---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import PageSection from '../components/PageSection.astro'

interface Props {
  title: string
  label: string
  activePath: '/projects' | '/photography'
  entry: CollectionEntry<'projects'> | CollectionEntry<'photography'>
}

const { title, label, activePath, entry } = Astro.props
---

<BaseLayout title={title}>
  <PageSection label={label} activePath={activePath}>
    <article class="max-w-3xl">
      <header class="border-b border-rule pb-8 dark:border-night-rule md:pb-10">
        <h1 class="font-editorial text-[clamp(2.4rem,5vw,4.8rem)] leading-[0.94] tracking-[-0.04em] text-ink dark:text-night-ink">
          {entry.data.title}
        </h1>
      </header>
      <slot />
    </article>
  </PageSection>
</BaseLayout>
