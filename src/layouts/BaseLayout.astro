---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Ashwin Chempolil — Software Engineer',
  description = 'Software engineer with a focus on distributed systems and cloud infrastructure.',
  ogImage = '/favicon.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- No-flash tint engine: runs synchronously before paint -->
    <script is:inline>
      (function () {
        // Cycle order + per-tint bg + color-scheme must match ThemeToggle + global.css.
        var TINTS = ['dmg', 'pocket', 'amber', 'p1', 'paper', 'vfd'];
        var BG = {
          dmg: '#9bbc0f', pocket: '#c6cbb6', amber: '#1a1206',
          p1: '#0a160a', paper: '#d7dde0', vfd: '#04110f'
        };
        var DARK = { amber: 1, p1: 1, vfd: 1 }; // dark-background tints

        function applyTint() {
          var stored = localStorage.getItem('tint') || '';
          var tint = TINTS.indexOf(stored) !== -1 ? stored : 'dmg';
          var html = document.documentElement;
          if (tint === 'dmg') {
            html.removeAttribute('data-theme'); // :root is DMG default
          } else {
            html.setAttribute('data-theme', tint);
          }
          // Paint-fallbacks so dark tints never flash white before CSS loads.
          html.style.backgroundColor = BG[tint];
          html.style.colorScheme = DARK[tint] ? 'dark' : 'light';
          localStorage.setItem('tint', tint);
        }
        applyTint();
        // Re-apply after ClientRouter navigations so the tint survives transitions.
        document.addEventListener('astro:after-swap', applyTint);
      })();
    </script>

    <!-- Fonts — Pairing 03: Instrument Serif (display) + Instrument Sans (body) + Fragment Mono (mono) -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" preload />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Client-side navigation (view transitions) -->
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main class="mx-auto w-full max-w-[60rem]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
