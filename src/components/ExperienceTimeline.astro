---
/**
 * ExperienceTimeline — renders all `work` collection entries as a stacked
 * card timeline, sorted by the `order` field (ascending: 0 = most recent).
 *
 * Pattern: Reference theme recreation (timeline-pattern.md)
 * ──────────────────────────────────────────────────────────
 * • No vertical spine, no node/dot markers — pure card stacking.
 * • Company logos (text-based fallback) use the reference's negative-offset
 *   desktop treatment: absolutely positioned at md:-left-16 so they float
 *   into the negative space left of each card.
 * • Layout: Section wrapper 1/3 label + 2/3 content, collapses mobile.
 * • Typography: Instrument Sans for title/body, Fragment Mono for
 *   period/company (font-mono). Logo monogram uses Instrument Serif (font-display).
 *   Terracotta (text-accent) for company names
 *   per final-identity.md usage rules.
 * • No card-level href — cards are <div> elements. Company links are rendered
 *   as inline <a> tags within the card body. This avoids nested <a> elements
 *   (which would be invalid HTML) when bullet links also exist in the card.
 * • Dark mode: all token utilities resolve via var(--brand-*) live references;
 *   no inline OKLCH literals.
 *
 * Usage (home Variant A, /work page, or any page):
 *   <ExperienceTimeline />
 *   <!-- No props needed — self-contained, reads from collection. -->
 *
 * Reuse notes for U9/U10:
 *   Drop <ExperienceTimeline /> directly into index.astro (Variant A) or
 *   the /work page. The component renders its own <Section id="experience">
 *   scroll anchor. Do not wrap it in another <section>.
 */

import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Card from './Card.astro';
import BrandIcon from './BrandIcon.astro';
// NEU wordmark lives in public/logos/ and is referenced by URL (not imported);
// it is a brand-red PD wordmark, kept full-color, so it stays an <img>.

// Sort ascending: order 0 = most recent role, rendered first.
const entries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order
);

// Company link map — used to render an inline company <a> within the card body.
// Cards are rendered as <div> (no href prop) to avoid nested <a> elements when
// bullet links also exist in the same card.
const COMPANY_HREFS: Record<string, string> = {
  'Amazon Web Services': 'https://aws.amazon.com',
  'Northeastern University': 'https://www.northeastern.edu',
  'Active.ai': 'https://www.active.ai',
};

// Company → logo descriptor used to render the exact brand mark in the card
// header logo slot. `kind` selects the render path:
//   'brand'  → inline BrandIcon glyph (currentColor — themes in light/dark)
//   'img'    → <img> to a full-color SVG in public/logos/ (NEU brand red)
//   'word'   → typographic wordmark fallback (asset unobtainable)
type LogoDescriptor =
  | { kind: 'brand'; icon: 'github' | 'linkedin' | 'aws'; label: string }
  | { kind: 'img'; src: string; label: string }
  | { kind: 'word'; primary: string; accent: string; label: string };

const COMPANY_LOGOS: Record<string, LogoDescriptor> = {
  'Amazon Web Services': { kind: 'brand', icon: 'aws', label: 'Amazon Web Services' },
  'Northeastern University': {
    kind: 'img',
    src: '/logos/northeastern.svg',
    label: 'Northeastern University',
  },
  'Active.ai': { kind: 'word', primary: 'active', accent: '.ai', label: 'Active.ai' },
};
---

<Section id="experience" label="experience">
  <div class="flex flex-col gap-y-4">
    {entries.map((entry) => {
      const href = COMPANY_HREFS[entry.data.company];
      const logo = COMPANY_LOGOS[entry.data.company];
      const bullets = entry.data.bullets ?? [];

      return (
        <Card
          heading={entry.data.title}
          meta={entry.data.period}
        >
          <!-- Logo slot: exact brand mark in a fixed 40x40 chip. All three
               render paths share the same chip chrome (surface + border + ring)
               so logos line up uniformly down the timeline regardless of glyph
               shape. Chip background guarantees the brand-red NEU wordmark and
               the AWS smile stay legible on both the cream and dark page bg. -->
          <span
            slot="logo"
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-surface border border-border ring-1 ring-border/60 overflow-hidden select-none"
          >
            {logo.kind === 'brand' && (
              <BrandIcon name={logo.icon} title={logo.label} class="w-5 h-5 text-primary" />
            )}
            {logo.kind === 'img' && (
              <img
                src={logo.src}
                alt={`${logo.label} logo`}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class="w-8 h-auto"
              />
            )}
            {logo.kind === 'word' && (
              <span aria-hidden="true" class="font-display text-[0.6rem] font-semibold leading-none tracking-tight text-primary">
                {logo.primary}<span class="text-accent">{logo.accent}</span>
              </span>
            )}
          </span>

          <!-- Company name — rendered as an inline link when a href exists,
               plain text otherwise. Card is a <div> (no href prop) so this
               <a> is the only interactive element; no nested <a> conflict. -->
          {href ? (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm text-accent hover:text-accent-hover transition-colors duration-150"
            >
              {entry.data.company}
            </a>
          ) : (
            <p class="font-mono text-sm text-accent">{entry.data.company}</p>
          )}

          <!-- Bullet body — only rendered when bullets exist -->
          {bullets.length > 0 && (
            <ul class="list-disc ml-4 mt-2 space-y-1.5">
              {bullets.map((bullet) => (
                <li class="leading-snug">
                  {bullet.team && (
                    <span class="font-mono text-xs text-accent mr-1.5">
                      [{bullet.team}]
                    </span>
                  )}
                  {bullet.href ? (
                    <a
                      href={bullet.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-border underline-offset-2 hover:text-accent hover:decoration-accent transition-colors duration-150"
                    >
                      {bullet.text}
                    </a>
                  ) : (
                    <span>{bullet.text}</span>
                  )}
                </li>
              ))}
            </ul>
          )}

          <!-- Optional subtitle (e.g. course name for teaching roles) -->
          {entry.data.subtitle && (
            <p class="mt-2 font-mono text-xs text-secondary italic">
              {entry.data.subtitle}
            </p>
          )}
        </Card>
      );
    })}
  </div>
</Section>
