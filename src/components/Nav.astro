---
import { NAV_LINKS, SITE_NAME } from '../data/site'

interface Props {
  activePath: '/' | '/work' | '/projects' | '/photography' | '/contact'
}

const { activePath } = Astro.props
const titleClass =
  activePath === '/'
    ? 'text-ink dark:text-night-ink'
    : 'text-ink-muted hover:text-ink dark:text-night-muted dark:hover:text-night-ink'
---

<nav class="sticky top-0 z-50 border-b border-rule/80 bg-paper/90 backdrop-blur-sm dark:border-night-rule dark:bg-night/85">
  <div class="page-shell flex items-center justify-between gap-4 py-4">
    <a
      href="/"
      class:list={[
        'font-editorial text-[1.18rem] leading-none tracking-[-0.03em] transition-colors sm:text-[1.35rem]',
        titleClass,
      ]}
    >
      {SITE_NAME.toLowerCase()}
    </a>
    <div class="flex items-center gap-2 sm:gap-4">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'border-b border-transparent px-1 py-1 font-mono text-[0.62rem] uppercase tracking-[0.18em] transition-colors sm:text-[0.68rem]',
            activePath === href
              ? 'border-ink/70 text-ink dark:border-night-ink/70 dark:text-night-ink'
              : 'text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink',
          ]}
        >
          {label}
        </a>
      ))}
      <button
        type="button"
        class="inline-flex h-8 w-8 items-center justify-center rounded-full text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink"
        data-theme-toggle
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <svg
          class="hidden h-3.5 w-3.5 fill-none stroke-current [html[data-theme='light']_&]:block dark:hidden"
          data-theme-icon="moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
        <svg
          class="hidden h-3.5 w-3.5 fill-none stroke-current [html[data-theme='dark']_&]:block"
          data-theme-icon="sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>
