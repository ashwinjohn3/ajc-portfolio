---
import { NAV_LINKS, SITE_NAME } from '../data/site'

interface Props {
  activePath: '/' | '/work' | '/projects' | '/photography' | '/contact'
}

const { activePath } = Astro.props
---

<nav class="sticky top-0 z-50 border-b border-rule bg-paper dark:border-night-rule dark:bg-night">
  <div class="page-shell flex items-center justify-between gap-4 py-3">
    <a
      href="/"
      class:list={[
        'text-[0.78rem] leading-none transition-colors',
        activePath === '/'
          ? 'text-ink dark:text-night-ink'
          : 'text-ink-muted hover:text-ink dark:text-night-muted dark:hover:text-night-ink',
      ]}
    >
      {SITE_NAME.toLowerCase()}
    </a>
    <div class="flex items-center gap-px hidden md:flex">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'px-[0.35rem] py-0 font-mono text-[0.78rem] transition-colors',
            activePath === href
              ? 'text-ink dark:text-night-ink'
              : 'text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink',
          ]}
        >
          [{label}]
        </a>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="md:hidden inline-flex h-6 w-6 items-center justify-center text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink"
        aria-label="Open menu"
        id="menu-button"
      >
        <svg
          class="h-[14px] w-[14px] fill-none stroke-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
      <button
        type="button"
        class="inline-flex h-6 w-6 items-center justify-center pl-2 text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink"
        data-theme-toggle
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <svg
          class="hidden h-[14px] w-[14px] fill-none stroke-current [html[data-theme='light']_&]:block dark:hidden"
          data-theme-icon="moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
        <svg
          class="hidden h-[14px] w-[14px] fill-none stroke-current [html[data-theme='dark']_&]:block"
          data-theme-icon="sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile menu -->
  <div class="md:hidden" id="mobile-menu">
    <div class="page-shell border-t border-rule bg-paper dark:border-night-rule">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'block px-6 py-3 font-mono text-[0.78rem] transition-colors',
            activePath === href
              ? 'text-ink dark:text-night-ink'
              : 'text-ink-faint hover:text-ink dark:text-night-muted dark:hover:text-night-ink',
          ]}
        >
          [{label}]
        </a>
      ))}
    </div>
  </div>
  
  <script is:inline>
    (() => {
      const button = document.getElementById('menu-button')
      const menu = document.getElementById('mobile-menu')
      
      if (!button || !menu) return
      
      button.addEventListener('click', () => {
        menu.classList.toggle('hidden')
        // Optional: change icon to close (X) when open
        // We'll leave the icon as is for simplicity, but you could toggle between hamburger and X
      })
    })()
  </script>
</nav>
