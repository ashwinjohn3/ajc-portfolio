---
/**
 * Nav.astro
 * U5 — Sticky top navigation bar.
 *
 * Layout: site name left · nav links center-right · ThemeToggle far right.
 * Typography: Spline Sans Mono for all nav labels (technical axis per identity spec).
 * Hover: border-brighten (border-color transition only, no scale/lift).
 * Feature flags: links gated by PUBLIC_SHOW_PROJECTS / PUBLIC_SHOW_PHOTOGRAPHY
 *   are hidden when flags are false (default).
 *
 * Responsive: collapses gracefully — site name stays, links wrap on narrow
 *   viewports. No JS framework, no mobile hamburger (links are few, wrap is fine).
 */

import { visibleNavLinks } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const links = visibleNavLinks();
const currentPath = Astro.url.pathname;
---

<header class="nav-header sticky top-0 z-50 w-full border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="nav-inner max-w-[60rem] mx-auto px-6 sm:px-10 h-14 flex items-center gap-6">

    <!-- Site name — left anchor (full-name brand). min-w-0 + truncate let the
         long name shrink/ellipsize on narrow viewports instead of forcing
         horizontal overflow (375px nav row must never scroll). -->
    <a
      href="/"
      class="nav-site-name font-mono text-sm font-bold text-primary min-w-0 truncate transition-opacity duration-200 hover:opacity-70"
      transition:name="site-name"
    >
      Ashwin John Chempolil
    </a>

    <!-- Spacer — pushes links + toggle to the right -->
    <div class="flex-1" aria-hidden="true"></div>

    <!-- Nav links -->
    <nav aria-label="Main navigation">
      <ul class="flex items-center gap-1 list-none m-0 p-0" role="list">
        {links.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href + '/');
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'nav-link font-mono text-xs px-2 py-1 rounded border transition-colors duration-200',
                  isActive
                    ? 'border-primary text-primary'
                    : 'border-transparent text-secondary hover:border-border hover:text-primary',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                [{link.label}]
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Theme toggle — far right -->
    <ThemeToggle />

  </div>
</header>
