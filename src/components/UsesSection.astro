---
/**
 * UsesSection — renders the `uses` content collection as a balanced grid of
 * category cards, each containing an ICON-GRID of tools.
 *
 * Adopted shape (POLISH-ADOPT): the tool icon-grid from the inspiration
 * template, re-skinned to the 6-tint duotone system. Each category is a Card
 * (same chrome as /work). Inside, tools render as a responsive grid of cells —
 *   • icon glyph (forced to ink) + Spline Sans Mono name in a Chip
 *   • optional description below
 *   • a scale-free hover-overlay (border brightens, no transform/motion — so it
 *     is reduced-motion safe by construction)
 *
 * Icons are OPTIONAL. The `uses` schema gained an optional `icon` field; tools
 * without one render gracefully (label-only cell). No fake tools are invented —
 * placeholder TODO entries simply show no glyph and a muted italic badge.
 *
 * Icon-to-ink:
 *   • brand → BrandIcon (inline currentColor, themes natively via text-primary)
 *   • svg   → raw simple-icons path drawn with fill="currentColor" (ink). Any
 *             full-color asset that ever enters here is collapsed by the
 *             `.neu-duotone` filter (recipe replicated, scoped, below) so no
 *             third hue can break the duotone screen.
 *
 * Layout: self-contained, full site container (max-w-[60rem], matching
 * Nav/Hero/Footer). Categories sit in a 1-col (<md) / 2-col (≥md) grid;
 * `items-start` keeps unequal-height cards top-aligned.
 *
 * Consumes: src/content/uses/*.md (sorted by `order`).
 */

import { getCollection } from 'astro:content';
import Card from './Card.astro';
import Chip from './Chip.astro';
import BrandIcon from './BrandIcon.astro';

const uses = (await getCollection('uses')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="uses" class="w-full max-w-[60rem] mx-auto px-6 sm:px-10 pb-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5 items-start">
    {uses.map((cat) => (
      <Card heading={cat.data.category} class="h-full">
        {/* Icon-grid: tool cells, 1-up < sm, 2-up ≥ sm. */}
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-1">
          {cat.data.items.map((item) => {
            const isTodo = item.description?.startsWith('TODO');
            const icon = item.icon;
            return (
              <li
                class:list={[
                  // Scale-free hover-overlay cell — border brightens, no transform.
                  'group relative rounded-[3px] p-2.5',
                  'border border-transparent',
                  'transition-colors duration-200',
                  'hover:border-border hover:bg-surface/40',
                ]}
              >
                <div class="flex items-center gap-2">
                  {/* Icon chip — only when a glyph exists; graceful when absent. */}
                  {icon && (
                    <Chip label={item.name}>
                      <Fragment slot="icon">
                        {icon.kind === 'brand' ? (
                          <BrandIcon name={icon.name} class="w-full h-full text-primary" />
                        ) : (
                          <svg
                            viewBox={icon.viewBox ?? '0 0 24 24'}
                            fill="currentColor"
                            class="tool-glyph w-full h-full text-primary"
                            aria-hidden="true"
                          >
                            <path d={icon.path} />
                          </svg>
                        )}
                      </Fragment>
                    </Chip>
                  )}

                  {/* Label — as a plain link/text when there is no icon chip. */}
                  {!icon && (
                    item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-xs text-accent hover:text-accent-hover transition-colors duration-200 underline underline-offset-2"
                      >
                        {item.name}
                      </a>
                    ) : (
                      <span class="font-mono text-xs text-primary">{item.name}</span>
                    )
                  )}

                  {/* When an icon chip carries the name, expose the link separately. */}
                  {icon && item.url && (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${item.name} — website`}
                      class="font-mono text-[0.8125rem] text-accent hover:text-accent-hover transition-colors duration-200 underline underline-offset-2 shrink-0"
                    >
                      ↗
                    </a>
                  )}
                </div>

                {/* Description / TODO badge */}
                {item.description && (
                  <p
                    class:list={[
                      'mt-1.5 text-xs leading-relaxed',
                      isTodo ? 'text-secondary/50 italic' : 'text-secondary',
                    ]}
                  >
                    {item.description}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </Card>
    ))}
  </div>
</section>

<style>
  /* ------------------------------------------------------------------
     Force any full-color tool SVG to the duotone ink step — same recipe as
     ExperienceTimeline's `.neu-duotone`, replicated + SCOPED here (global.css
     is owned elsewhere). Inline simple-icons paths already draw in
     currentColor, so this only matters if a full-color asset is ever slotted;
     keeping it here makes the grid duotone-safe by construction.
     ------------------------------------------------------------------ */
  .tool-glyph.neu-duotone {
    filter: grayscale(1) contrast(1.15) brightness(0.55);
    opacity: 0.92;
    mix-blend-mode: multiply;
  }
  :global([data-theme='p1']) .tool-glyph.neu-duotone {
    filter: grayscale(1) contrast(1.1) brightness(1.8) invert(1);
    mix-blend-mode: screen;
    opacity: 0.9;
  }
</style>
