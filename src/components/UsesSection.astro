---
/**
 * UsesSection — renders the `uses` content collection as a balanced grid of
 * category cards. Each category is a Card (same chrome as /work); each item is
 * a mono-label row with an optional link and description.
 *
 * Layout (USER-FIX-3): self-contained, full site container (max-w-[60rem],
 * matching Nav/Hero/Footer). Categories sit in a responsive grid —
 *   • 1 column  < md   (stacked)
 *   • 2 columns ≥ md   (balanced, symmetric pair)
 * `items-start` keeps unequal-height cards top-aligned so the grid stays tidy.
 *
 * Deliberately NOT wrapped in Section.astro: Section forces a 1/3-label + 2/3
 * content split that crammed the cards into a narrow right column (the old
 * off-center look) and emitted a second "tools & setup" label that duplicated
 * the page header. This component now owns its own container + grid instead.
 *
 * TODO placeholder items (description starts with "TODO") render with a muted
 * italic badge so the section reads as complete before content is filled in.
 *
 * Consumes: src/content/uses/*.md (sorted by `order` field)
 */

import { getCollection } from 'astro:content';
import Card from './Card.astro';

const uses = (await getCollection('uses')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="uses" class="w-full max-w-[60rem] mx-auto px-6 sm:px-10 pb-16">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5 items-start">
    {uses.map((cat) => (
      <Card heading={cat.data.category} class="h-full">
        <ul class="flex flex-col gap-2.5 mt-1">
          {cat.data.items.map((item) => {
            const isTodo = item.description?.startsWith('TODO');
            return (
              <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                {/* Item name — link if url present */}
                {item.url ? (
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-accent hover:text-accent-hover transition-colors duration-200 underline underline-offset-2 shrink-0"
                  >
                    {item.name}
                  </a>
                ) : (
                  <span class="font-mono text-xs text-primary shrink-0">
                    {item.name}
                  </span>
                )}
                {/* Description or TODO badge */}
                {item.description && (
                  isTodo ? (
                    <span class="text-xs text-secondary/50 italic">
                      {item.description}
                    </span>
                  ) : (
                    <span class="text-xs text-secondary">
                      — {item.description}
                    </span>
                  )
                )}
              </li>
            );
          })}
        </ul>
      </Card>
    ))}
  </div>
</section>
