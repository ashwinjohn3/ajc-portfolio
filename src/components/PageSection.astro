---
import Nav from './Nav.astro'

interface Props {
  label: string
  activePath: '/work' | '/projects' | '/photography' | '/contact'
}

const { label, activePath } = Astro.props
---

<Nav activePath={activePath} />
<main>
  <section class="section-shell">
    <p class="section-label">{label}</p>
    <div>
      <slot />
    </div>
  </section>
</main>
