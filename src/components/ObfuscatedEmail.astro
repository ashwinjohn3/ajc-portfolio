---
/**
 * ObfuscatedEmail — renders a clickable envelope ICON with ZERO plaintext email
 * in server-emitted HTML. The address is stored as a char-code array and
 * decoded client-side by an is:inline script.
 *
 * Security model:
 *   - The <a> href starts as "#" (inert).
 *   - An is:inline script (runs once on DOMContentLoaded) decodes the char-code
 *     array and sets ONLY href="mailto:..." on the anchor. It never writes the
 *     address into textContent, so the readable email never enters the DOM.
 *   - Because is:inline emits the script verbatim into the HTML, a grep of
 *     dist/ for "ashwinchempolil" or "@gmail" must return zero results.
 *   - The char-code array below encodes: ashwinchempolil@gmail.com
 *
 * Presentation:
 *   - The clickable element is an inline Lucide "mail" envelope SVG that inherits
 *     currentColor (stroke). No readable email text is rendered — the icon IS
 *     the affordance. aria-label labels the link; the svg is aria-hidden.
 *
 * Props:
 *   label    — accessible link label (default: "Email Ashwin")
 *   class    — forwarded to the <a> tag
 *
 * How to regenerate codes if the address changes:
 *   node -e "console.log([...'newemail@example.com'].map(c => c.charCodeAt(0)).join(','))"
 */

interface Props {
  label?: string;
  class?: string;
}

const { label = 'Email Ashwin', class: className } = Astro.props;

// ashwinchempolil@gmail.com encoded as char codes — never plaintext in this file
// prettier-ignore
const CODES = [97,115,104,119,105,110,99,104,101,109,112,111,108,105,108,64,103,109,97,105,108,46,99,111,109];
---

<a
  id="obfuscated-email"
  href="#"
  class:list={[
    'inline-flex items-center text-accent hover:text-accent-hover transition-colors duration-200',
    className,
  ]}
  aria-label={label}
>
  {/* Lucide "mail" — envelope, inherits currentColor via stroke */}
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="w-5 h-5"
    aria-hidden="true"
  >
    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
  </svg>
</a>

<script is:inline define:vars={{ CODES }}>
  (function () {
    function decode() {
      var el = document.getElementById('obfuscated-email');
      if (!el) return;
      var addr = CODES.map(function (c) { return String.fromCharCode(c); }).join('');
      el.href = 'mailto:' + addr;
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', decode);
    } else {
      decode();
    }
    // Re-decode after ClientRouter navigations
    document.addEventListener('astro:after-swap', decode);
  })();
</script>
