---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<article>
  <div class="simple-list-row">
    <div>
      <a
        href={`/projects/${project.slug}`}
        class="inline-block text-ink hover:text-accent dark:text-night-ink dark:hover:text-night-ink"
      >
        {project.data.title}
      </a>
      <div class="simple-list-sub">{project.data.summary}</div>
      <div class="detail-group mt-2">
        {project.data.tags.map((tag) => (
          <span class="detail-chip">
            {tag}
          </span>
        ))}
      </div>
    </div>
    <div class="simple-list-meta">{project.data.year}</div>
  </div>
</article>
