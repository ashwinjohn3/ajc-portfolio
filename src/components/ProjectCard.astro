---
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<article>
  <div class="grid gap-4 border-b border-rule py-5 dark:border-night-rule md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
    <div class="space-y-3">
      <a
        href={`/projects/${project.slug}`}
        class="inline-block font-editorial text-[1.35rem] leading-tight tracking-[-0.03em] text-ink hover:text-accent dark:text-night-ink dark:hover:text-paper"
      >
        {project.data.title}
      </a>
      <div class="text-[0.98rem] leading-8 text-ink-muted dark:text-night-muted">{project.data.summary}</div>
      <div class="flex flex-wrap gap-2">
        {project.data.tags.map((tag) => (
          <span class="border border-rule px-2.5 py-1 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ink-muted dark:border-night-rule dark:text-night-muted">
            {tag}
          </span>
        ))}
      </div>
    </div>
    <div class="pt-1 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-ink-faint dark:text-night-faint">{project.data.year}</div>
  </div>
</article>
