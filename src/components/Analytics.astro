---
const key = import.meta.env.PUBLIC_POSTHOG_KEY;
const host = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
if (import.meta.env.DEV && !key) {
  console.error('PUBLIC_POSTHOG_KEY variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once PUBLIC_POSTHOG_KEY is configured');
}
---

{import.meta.env.PROD && key && (
  <script
    is:inline
    defer
    src="/portfolio-analytics.js"
    data-key={key}
    data-host={host}
    data-enabled="true"
    data-branch="redesign/personal-brand"
  />
)}
