---
interface Photo {
  src: string
  alt: string
  width: number
  height: number
}

interface Props {
  photos: Photo[]
}

const { photos } = Astro.props
---

<div class="mt-3 grid gap-3 md:mt-4 md:grid-cols-2">
  {photos.map((photo) => (
    <figure class="overflow-hidden bg-paper-soft dark:bg-night-soft">
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] h-full w-full object-cover"
      />
    </figure>
  ))}
</div>
