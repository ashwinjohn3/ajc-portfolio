---
/**
 * ThemeToggle.astro
 * TINT CYCLER — Zero-framework analog-display tint switcher.
 *
 * Click cycles dmg → pocket → p1 → dmg.
 * Sets [data-theme] on <html> (dmg removes the attribute = :root default),
 * persists to localStorage('tint'), and shows the current tint as a single
 * inline line-icon (Lucide, MIT) that evokes its role:
 *   dmg gamepad-2 (Game Boy DMG, default) · pocket sun (light) · p1 moon (dark).
 * Icons are monochrome and inherit the tint ink via `stroke="currentColor"`
 * (no third hue). They are decorative (aria-hidden); the readable tint name +
 * next-tint hint live in the button's aria-label so screen readers stay
 * informative.
 *
 * Survives ClientRouter navigation via astro:after-swap event delegation
 * (bound once per document lifecycle). BaseLayout's is:inline script owns
 * pre-paint application; this toggle only flips the attribute + storage +
 * icon, so there is no double-apply on load.
 *
 * Contract with BaseLayout:
 *   BaseLayout's is:inline script reads localStorage('tint') and sets
 *   data-theme pre-paint (and on astro:after-swap). Both derive their tint
 *   order from the SINGLE-SOURCE registry (src/lib/tints.ts), injected at
 *   build time via define:vars, so they can never disagree. (The no-flash
 *   script needs no icon data — icons are purely the toggle's visual.)
 */
import { TINT_IDS, TINT_ICON } from '../lib/tints';

/**
 * Inner SVG markup per icon, viewBox 0 0 24 24. Lucide line-icons (MIT):
 * gamepad-2, sun, moon. Stroke attributes live on the parent <svg> (below)
 * so each icon stays a single consistent 1.5px stroke that tracks currentColor.
 */
const ICON_PATHS: Record<string, string> = {
  // lucide: gamepad-2
  gamepad:
    '<line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/>' +
    '<line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/>' +
    '<path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152' +
    'C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344' +
    'a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258' +
    'c-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/>',
  // lucide: sun
  sun:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/>' +
    '<path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>' +
    '<path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/>' +
    '<path d="m19.07 4.93-1.41 1.41"/>',
  // lucide: moon
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
};

/**
 * Fixed stroke attributes shared by every icon SVG (parent + client clone).
 * Kept in one place so the inline render below and the client-side cycler
 * produce byte-identical markup.
 */
const SVG_OPEN =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" ' +
  'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" ' +
  'stroke-linejoin="round" aria-hidden="true" focusable="false" class="tint-icon-svg">';

/** Server-render the default (dmg) icon so first paint shows the right glyph. */
const dmgIconHtml = SVG_OPEN + ICON_PATHS[TINT_ICON.dmg] + '</svg>';
---

<button
  id="tint-toggle"
  type="button"
  aria-label="Display tint"
  class="tint-toggle font-mono text-sm leading-none text-secondary border border-border rounded px-2 py-1 transition-colors duration-200 hover:border-primary hover:text-primary cursor-pointer"
>
  <span id="tint-label" class="tint-label" aria-hidden="true" set:html={dmgIconHtml} />
</button>

<style>
  /*
   * Fixed square icon box so every tint's line-icon occupies an IDENTICAL
   * footprint — the button width never changes between gamepad/sun/moon, so
   * there is no nav-height/width layout shift when cycling. The inline SVG is
   * a constant 18×18, but the 1.25rem grid box keeps centering stable even if
   * an icon's optical bounds differ. The SVG inherits the tint ink via
   * stroke="currentColor" (set on the <svg> in the frontmatter), so no color
   * rule is needed here.
   */
  .tint-label {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    line-height: 0;
  }

  .tint-label :global(svg.tint-icon-svg) {
    display: block;
  }
</style>

<script is:inline define:vars={{ TINTS: TINT_IDS, ICON: TINT_ICON, ICON_PATHS, SVG_OPEN }}>
  (function () {
    // TINTS (cycle order) + ICON (per-tint icon id) + ICON_PATHS (inline-SVG
    // inner markup) + SVG_OPEN (shared <svg> open tag) are injected at build
    // time from the single-source registry (src/lib/tints.ts) via define:vars,
    // so the client cycler renders byte-identical markup to the server.
    function currentTint() {
      var attr = document.documentElement.getAttribute('data-theme');
      return TINTS.indexOf(attr) !== -1 ? attr : 'dmg';
    }

    function iconHtml(tint) {
      var id = ICON[tint] || ICON.dmg;
      return SVG_OPEN + (ICON_PATHS[id] || ICON_PATHS[ICON.dmg]) + '</svg>';
    }

    function applyTint(tint) {
      var html = document.documentElement;
      if (tint === 'dmg') {
        html.removeAttribute('data-theme'); // :root is DMG — no attribute needed
      } else {
        html.setAttribute('data-theme', tint);
      }
      localStorage.setItem('tint', tint);
    }

    function syncLabel() {
      var cur = currentTint();
      var nextIdx = (TINTS.indexOf(cur) + 1) % TINTS.length;
      var next = TINTS[nextIdx];
      var label = document.getElementById('tint-label');
      var btn = document.getElementById('tint-toggle');
      if (label) label.innerHTML = iconHtml(cur);
      if (btn) btn.setAttribute('aria-label', 'Display tint: ' + cur + '. Click for ' + next + '.');
    }

    function cycleTint() {
      var cur = currentTint();
      var next = TINTS[(TINTS.indexOf(cur) + 1) % TINTS.length];
      applyTint(next);
      syncLabel();
    }

    function bindToggle() {
      var btn = document.getElementById('tint-toggle');
      if (btn) {
        btn.removeEventListener('click', cycleTint); // ClientRouter reuses DOM
        btn.addEventListener('click', cycleTint);
      }
      syncLabel(); // reflect whatever BaseLayout applied pre-paint
    }

    bindToggle();
    document.addEventListener('astro:after-swap', bindToggle);
  })();
</script>
