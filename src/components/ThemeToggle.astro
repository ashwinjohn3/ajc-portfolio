---
/**
 * ThemeToggle.astro
 * TINT CYCLER — Zero-framework analog-display tint switcher.
 *
 * Click cycles dmg → pocket → amber → p1 → paper → vfd → dmg.
 * Sets [data-theme] on <html> (dmg removes the attribute = :root default),
 * persists to localStorage('tint'), and shows the current tint as a single
 * emoji that evokes that display hardware:
 *   dmg 🎮 (Game Boy DMG) · pocket 🕹️ (Game Boy Pocket) · amber 🟠 (amber CRT) ·
 *   p1 🟢 (P1 green phosphor) · paper 📄 (e-paper white) · vfd 🔵 (blue VFD).
 * The emoji is decorative (aria-hidden); the readable tint name + next-tint
 * hint live in the button's aria-label so screen readers stay informative.
 * (Emoji is intentional HERE ONLY — the rest of the site stays emoji-free.)
 *
 * Survives ClientRouter navigation via astro:after-swap event delegation
 * (bound once per document lifecycle). BaseLayout's is:inline script owns
 * pre-paint application; this toggle only flips the attribute + storage +
 * label, so there is no double-apply on load.
 *
 * Contract with BaseLayout:
 *   BaseLayout's is:inline script reads localStorage('tint') and sets
 *   data-theme pre-paint (and on astro:after-swap). This component reuses
 *   the SAME tint order + the SAME label rule so they never disagree.
 */
---

<button
  id="tint-toggle"
  type="button"
  aria-label="Display tint"
  class="tint-toggle font-mono text-sm leading-none text-secondary border border-border rounded px-2 py-1 transition-colors duration-200 hover:border-primary hover:text-primary cursor-pointer"
>
  <span id="tint-label" class="tint-label" aria-hidden="true">🎮</span>
</button>

<script is:inline>
  (function () {
    // Single source of truth for the cycle order + display names.
    var TINTS = ['dmg', 'pocket', 'amber', 'p1', 'paper', 'vfd'];
    // One emoji per tint, evoking that display hardware. Decorative only —
    // the readable tint name stays in the aria-label.
    var EMOJI = {
      dmg: '🎮', pocket: '🕹️', amber: '🟠',
      p1: '🟢', paper: '📄', vfd: '🔵'
    };

    function currentTint() {
      var attr = document.documentElement.getAttribute('data-theme');
      return TINTS.indexOf(attr) !== -1 ? attr : 'dmg';
    }

    function applyTint(tint) {
      var html = document.documentElement;
      if (tint === 'dmg') {
        html.removeAttribute('data-theme'); // :root is DMG — no attribute needed
      } else {
        html.setAttribute('data-theme', tint);
      }
      localStorage.setItem('tint', tint);
    }

    function syncLabel() {
      var cur = currentTint();
      var nextIdx = (TINTS.indexOf(cur) + 1) % TINTS.length;
      var next = TINTS[nextIdx];
      var label = document.getElementById('tint-label');
      var btn = document.getElementById('tint-toggle');
      if (label) label.textContent = EMOJI[cur] || EMOJI.dmg;
      if (btn) btn.setAttribute('aria-label', 'Display tint: ' + cur + '. Click for ' + next + '.');
    }

    function cycleTint() {
      var cur = currentTint();
      var next = TINTS[(TINTS.indexOf(cur) + 1) % TINTS.length];
      applyTint(next);
      syncLabel();
    }

    function bindToggle() {
      var btn = document.getElementById('tint-toggle');
      if (btn) {
        btn.removeEventListener('click', cycleTint); // ClientRouter reuses DOM
        btn.addEventListener('click', cycleTint);
      }
      syncLabel(); // reflect whatever BaseLayout applied pre-paint
    }

    bindToggle();
    document.addEventListener('astro:after-swap', bindToggle);
  })();
</script>
