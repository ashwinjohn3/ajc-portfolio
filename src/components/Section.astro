---
/**
 * Section — 1/3 label + 2/3 content split (collapses to single-column on mobile).
 *
 * Props:
 *   id       — rendered as the <section> id; used for scroll anchors
 *   label    — Fragment Mono section label (e.g. "experience", "tools").
 *              Pass "" to omit the label column entirely (used by /work,
 *              where the shared PageHeader already carries the kicker).
 *
 * Usage:
 *   <Section id="experience" label="experience">
 *     ... cards or any content ...
 *   </Section>
 */

interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section
  id={id}
  class:list={[
    'px-6 sm:px-10 py-10',
    /* The top divider belongs to the labelled, stacked-section layout. When
       the label is omitted (header-driven page like /work), drop it so the
       content flows directly under the shared PageHeader. */
    label && 'border-t border-border',
  ]}
>
  <div class="flex flex-col gap-6 md:flex-row md:gap-10">
    {label && (
      <!-- 1/3 — section label (Fragment Mono, muted, uppercase tracking) -->
      <div class="md:w-1/3 shrink-0">
        <span class="font-mono text-xs uppercase tracking-widest text-secondary">
          {label}
        </span>
      </div>
    )}

    <!-- 2/3 — content slot (full width when the label column is omitted) -->
    <div class:list={[label ? 'md:w-2/3' : 'w-full', 'min-w-0']}>
      <slot />
    </div>
  </div>
</section>
