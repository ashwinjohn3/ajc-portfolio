---
/**
 * Hero.astro — centered profile-card homepage hero.
 *
 * Composition adopted faithfully from the inspiration template's landing hero
 * (srleom/astro-theme-resume index.astro hero) — a CENTERED VERTICAL STACK —
 * and re-skinned to this site's strict-duotone token system:
 *
 *   (profile photo — circle on a duotone surface plate)
 *        Ashwin John Chempolil                        ← serif display heading
 *      • Open to opportunities                         ← status badge, pulsing dot
 *   📍 Washington DC   ·   Connect on LinkedIn          ← centered wrapping labels
 *
 * Re-skin rules applied (KEEP the template layout, SWAP the skin):
 *   - Template's peach plate (#FFBE98, a third hue) → border-border + bg-surface.
 *   - Template's rounded-3xl pill → rounded-[3px] badge (Ashwin's radius rule).
 *   - Template's green pulsing dot (green = third hue) → bg-accent (the ink), so
 *     the composition stays strictly two-color in every tint.
 *   - Template's soft shadows dropped (anti-slop; a hairline border carries it).
 *
 * STRICT DUOTONE — every visual reads only the tint tokens (surface/border/
 * primary/secondary/accent), so all active tints (dmg/pocket/p1) resolve via
 * [data-theme] alone. No hardcoded hues; the colour photo is forced toward ink
 * via the scoped `.profile-duotone` filter (same recipe as ExperienceTimeline's
 * `.neu-duotone`, replicated + scoped here) so it harmonizes with the tints.
 *
 * The ONE animation: a subtle pulse on the status dot (the user's request).
 * It is a scoped @keyframes; prefers-reduced-motion turns it OFF (static dot).
 * The dot is aria-hidden — the real "Open to opportunities" text carries meaning.
 *
 * Full-bleed: the <section> breaks out of the parent max-w-[60rem] so the tint
 * field fills the viewport edge-to-edge between nav and footer; the inner column
 * (items-center) centres the profile card. `fill` keeps the footer pinned.
 */

import { Image } from 'astro:assets';
import { SOCIAL_LINKS } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import headshot from '../assets/headshot.jpg';

interface Props {
  /**
   * When true the hero stretches to fill the remaining viewport height
   * (flex-1 inside the column <main>) and vertically centres the profile card,
   * so the composition fills the body between nav and footer — keeping the
   * footer pinned to the bottom with no unfilled background.
   */
  fill?: boolean;
  /** Kept for API parity with the prior Hero so callers stay drop-in. */
  tagline?: string;
  ctaHref?: string;
  ctaLabel?: string;
  badgeText?: string;
}

const { fill = false } = Astro.props;
---

<!-- ============================================================
     Hero — centered profile card over the site's tint field. The <section>
     breaks out of the parent max-w-[60rem] (.hero-power below) so the
     transparent field fills the viewport edge-to-edge between nav and footer
     (footer pinned via the fill chain). The inner .hero-col restores the
     reading column and centres the card.
     ============================================================ -->
<section
  id="hero"
  class:list={[
    'hero-power relative',
    fill
      ? 'flex-1 flex flex-col justify-center'
      : 'min-h-[78vh] flex flex-col justify-center',
  ]}
  aria-label="Introduction"
>
  <div class="hero-col relative z-10 w-full max-w-[60rem] mx-auto px-6 sm:px-10 py-16">
    <!-- Centered vertical stack: photo → (name → status → labels). -->
    <div class="flex flex-col items-center gap-y-7 text-center">
      <!-- AVATAR — Ashwin's headshot on a duotone surface plate. The circular
           plate + hairline border are preserved; the photo fills the ring via
           object-cover and is framed on the face (it sits in the upper-middle of
           the source frame). A uniform grayscale+contrast (.profile-duotone)
           harmonizes the photo with the strict-duotone tints — NEVER inverted on
           any tint, so it always reads as a normal (non-negative) photo.

           GOLDEN-RATIO SIZING (desktop ≥640px): the plate diameter is tied to
           the rendered width of the hero name by φ. Measured at 1280px the name
           "Ashwin John Chempolil" renders ~453px wide IN SYNE (the display font —
           narrower than the earlier Onest mis-measurement of 477px); the plate is
           sized to 453 / φ ≈ 280px so name_width ≈ 1.618 × diameter — the name
           stays wider than the circle (dominant) while the circle reads large and
           deliberate. Below sm the plate steps down to 13rem so it never crowds a
           375px viewport (where the name wraps); the φ relationship is the
           desktop target. -->

      <div
        class="profile-avatar flex h-52 w-52 sm:h-[280px] sm:w-[280px] items-center justify-center rounded-full border border-border bg-surface p-2"
      >
        <Image
          src={headshot}
          alt="Ashwin John Chempolil"
          width={560}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="profile-duotone h-full w-full rounded-full object-cover"
          style="object-position: 50% 28%;"
        />
      </div>

      <!-- Intro block — name, status badge, labels row. -->
      <div class="flex flex-col items-center gap-y-4">
        <!-- NAME — display heading, kept at its standard prominent size
             (text-4xl / 44px). It is the φ anchor: the avatar plate above is
             sized to name_width / φ, so this name stays the dominant, wider
             element while the circle scales up to meet it in golden proportion. -->
        <h1 class="font-display text-4xl leading-tight text-primary">
          Ashwin John Chempolil
        </h1>

        <!-- STATUS BADGE — rounded-[3px] (not a pill), duotone surface, pulsing
             ink dot. The dot is decorative (aria-hidden); the text is the label. -->
        <span
          class="status-badge flex flex-row items-center gap-x-3 rounded-[3px] border border-border bg-surface px-4 py-2"
        >
          <span class="status-dot-wrap relative flex h-2 w-2 items-center justify-center" aria-hidden="true">
            <span class="status-pulse absolute inline-flex h-2 w-2 rounded-full bg-accent"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span class="font-mono text-sm font-medium text-primary">Open to opportunities</span>
        </span>

        <!-- LABELS ROW — centered, wrapping: location + LinkedIn. -->
        <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 font-mono text-sm text-secondary">
          <span class="flex flex-row items-center gap-x-2">
            <!-- Location pin — inline svg, forced to ink (text-primary). -->
            <svg
              class="h-5 w-5 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Washington DC</span>
          </span>

          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-x-2 text-accent transition-colors hover:text-accent-hover"
          >
            <BrandIcon name="linkedin" class="h-5 w-5" />
            <span>Connect on LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================
     Centered profile-card hero — token-driven duotone. Every tint resolves
     via [data-theme] alone; no hardcoded hues.
     ========================================================== */
  .hero-power {
    /* Transparent so the base tint background (painted on <body>) shows
       through the full-bleed hero. */
    background: transparent;
    color: var(--color-primary);

    /* ---- FULL-BLEED BREAK-OUT ----
       The hero lives inside <main class="max-w-[60rem]">, which would clamp
       it to a 960px centred box. Negative inline margins (NOT width:100vw)
       stretch the section symmetrically to both viewport edges relative to the
       parent's box, so it stays centred and never forces horizontal page
       overflow from the scrollbar gutter. html{overflow-x:clip} (global.css)
       absorbs any sub-pixel delta. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* ---- Profile photo duotone treatment ----
     A colour headshot would break the strict-duotone screen, so force it toward
     ink: grayscale removes the hue, contrast/brightness shape it. Recipe mirrors
     ExperienceTimeline's `.neu-duotone`, scoped here.

     UNIFORM across ALL tints (dmg/pocket/p1) — there is deliberately NO per-theme
     invert. The photo must NEVER render as a negative/inverted image on the dark
     (p1) tint; a normal grayscale headshot reads correctly on every tint and fits
     the monochrome aesthetic. */
  .profile-duotone {
    filter: grayscale(1) contrast(1.05) brightness(0.95);
  }

  /* ---- Status dot pulse — the ONE animation (user request) ----
     A subtle expanding/fading ring behind the solid ink dot. Tasteful, low
     amplitude. The whole dot cluster is aria-hidden; the text carries meaning. */
  .status-pulse {
    transform-origin: center;
    animation: status-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes status-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Reduced motion — pulse OFF, static ink dot only. */
  @media (prefers-reduced-motion: reduce) {
    .status-pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
