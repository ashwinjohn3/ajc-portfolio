---
/**
 * Hero.astro — Composition A "DMG" (design-v2 ballot, band A)
 *
 * Kubrick dead-center one-point axis · monolithic centered title card ·
 * golden-ratio (φ) type scale · monochrome duotone discipline.
 *
 * Layout: a centered title card on a dead-center vertical axis (hairline guide).
 * Type hierarchy (φ scale, base 18px, ratio 1.618):
 *   "Ashwin"          → DOMINANT, clamp(3.6rem, 11vw, 5.29rem) = 76.2px  (Instrument Sans 700)
 *   "John Chempolil"  → subordinate, clamp(2.4rem, 7vw, 3.27rem) = 47.1px (Instrument Serif italic)
 *   tagline           → 18px Fragment Mono (mono "technical" axis)
 *
 * Duotone discipline: no peach ring, no green ping, no terracotta, no avatar.
 * The availability indicator survives as a MONOCHROME ink blip ("open to
 * opportunities") — the blip shadow pulses in the live ink color (text-primary),
 * never a hue.
 *
 * Colors resolve entirely from the tint engine via the existing Tailwind utility
 * names (bg-bg / bg-surface / text-primary / text-secondary / border-border).
 * In duotone, "accent" == ink step, so ink here is text-primary, not text-accent.
 *
 * Props:
 *   greeting   — kept in the interface for call-site compatibility (unused in the
 *                title-card composition; the kicker carries the role/location line)
 *   tagline    — the mono tagline beneath the title card
 *   ctaHref    — primary CTA link target
 *   ctaLabel   — primary CTA visible label
 *   badgeText  — availability text beside the monochrome blip
 */

interface Props {
  greeting?: string;
  tagline?: string;
  ctaHref?: string;
  ctaLabel?: string;
  badgeText?: string;
  /**
   * When true the hero stretches to fill the remaining viewport height
   * (flex-1 inside a column <main>) and vertically centers its content so
   * the dead-center axis runs the full body height with no unfilled bg
   * around it. Used on the lean home page.
   */
  fill?: boolean;
}

const {
  tagline = "I'm a software engineer based in Washington, DC.",
  ctaHref = '/contact',
  ctaLabel = 'Get in touch',
  badgeText = 'Open to opportunities',
  fill = false,
} = Astro.props;
---

<!-- ============================================================
     Hero — band A: dead-center axis, monolithic centered title card.
     The outer <section> owns the responsive padding (project rule).
     ============================================================ -->
<section
  id="hero"
  class:list={[
    'hero-dmg relative w-full px-6 sm:px-10',
    fill
      ? 'flex-1 flex flex-col justify-center py-16 sm:py-20'
      : 'pt-24 pb-16 sm:pt-32 sm:pb-20',
  ]}
  aria-label="Introduction"
>
  <!-- One-point center axis guide (hairline framing device, decorative) -->
  <div class="hero-axis" aria-hidden="true"></div>

  <div class="relative flex flex-col items-center text-center">

    <!-- Kicker — mono role/location line above the title card -->
    <p class="hero-kicker font-mono text-secondary">
      Software Engineer · Washington, DC
    </p>

    <!-- Monolithic title card · φ scale · Ashwin dominant -->
    <h1 class="hero-title" aria-label="Ashwin John Chempolil">
      <span class="hero-first block font-body font-bold text-primary">Ashwin</span>
      <span class="hero-last block font-display italic font-normal text-primary">John Chempolil</span>
    </h1>

    <!-- Tagline — Fragment Mono, 18px, secondary ink -->
    <p class="hero-tagline font-mono text-secondary">
      {tagline}
    </p>

    <!-- Availability — monochrome ink blip (no green ping, no color) -->
    <div class="hero-avail font-mono text-secondary" aria-label={badgeText}>
      <span class="hero-blip" aria-hidden="true"></span>
      <span>{badgeText}</span>
    </div>

    <!-- Primary CTA — ink underline, no hue fill -->
    <a
      href={ctaHref}
      class="hero-cta font-mono text-primary inline-flex items-center gap-1.5"
    >
      [{ctaLabel}]
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

  </div>
</section>

<style>
  /* ------------------------------------------------------------------
     Dot-matrix LCD grain — subtle 3px radial dot grid over the hero,
     scoped here so it never touches the sibling-owned global.css.
     Uses border-border (the duotone rule step) so the texture tints
     with the active theme and never introduces a hue.
     ------------------------------------------------------------------ */
  .hero-dmg {
    background-image: radial-gradient(
      color-mix(in srgb, var(--color-border) 45%, transparent) 0.5px,
      transparent 0.5px
    );
    background-size: 3px 3px;
  }

  /* One-point dead-center vertical axis (hairline, fades downward) */
  .hero-axis {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(var(--color-border), transparent 60%);
    opacity: 0.5;
  }

  /* Kicker — mono, wide tracking, uppercase. φ rhythm below it. */
  .hero-kicker {
    font-size: 0.6875rem;          /* 11px — Fragment Mono label step */
    letter-spacing: 0.34em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  /* Title card — φ type scale. line-height tightened for title-card mass. */
  .hero-title {
    line-height: 0.9;
  }

  .hero-first {
    /* φ step UP — 76.2px dominant */
    font-size: clamp(3.6rem, 11vw, 5.29rem);
    letter-spacing: -0.025em;
    line-height: 0.86;
  }

  .hero-last {
    /* φ step DOWN — 47.1px subordinate serif tail */
    font-size: clamp(2.4rem, 7vw, 3.27rem);
    letter-spacing: -0.01em;
    margin-top: 0.08em;
  }

  /* Tagline — 18px body floor, mono technical axis */
  .hero-tagline {
    font-size: 1.125rem;           /* 18px */
    margin-top: 1.35rem;
    max-width: 30rem;
  }

  /* Availability row — φ-derived spacing above */
  .hero-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    font-size: 0.65625rem;         /* 10.5px */
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Monochrome ink blip — shadow pulses in ink (text-primary), no hue */
  .hero-blip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0 var(--color-primary);
    animation: hero-blip 2.4s ease-out infinite;
  }

  @keyframes hero-blip {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* CTA — ink, underline-on-hover only (no hue) */
  .hero-cta {
    margin-top: 1.6rem;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .hero-cta:hover {
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blip {
      animation: none;
    }
  }
</style>
