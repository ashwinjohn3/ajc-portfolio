---
/**
 * Hero.astro — centered profile-card homepage hero.
 *
 * Composition adopted faithfully from the inspiration template's landing hero
 * (srleom/astro-theme-resume index.astro hero) — a CENTERED VERTICAL STACK —
 * and re-skinned to this site's strict-duotone token system:
 *
 *   (profile photo — circle on a duotone surface plate)
 *        Ashwin John Chempolil                        ← serif display heading
 *      • Open to opportunities                         ← status badge, pulsing dot
 *   📍 Washington DC   ·   Connect on LinkedIn          ← centered wrapping labels
 *
 * Re-skin rules applied (KEEP the template layout, SWAP the skin):
 *   - Template's peach plate (#FFBE98, a third hue) → border-border + bg-surface.
 *   - Template's rounded-3xl pill → rounded-[3px] badge (Ashwin's radius rule).
 *   - Template's green pulsing dot (green = third hue) → bg-accent (the ink), so
 *     the composition stays strictly two-color in every tint.
 *   - Template's soft shadows dropped (anti-slop; a hairline border carries it).
 *
 * STRICT DUOTONE — every visual reads only the tint tokens (surface/border/
 * primary/secondary/accent), so all active tints (dmg/pocket/p1) resolve via
 * [data-theme] alone. No hardcoded hues; the colour photo is forced toward ink
 * via the scoped `.profile-duotone` filter (same recipe as ExperienceTimeline's
 * `.neu-duotone`, replicated + scoped here) so it harmonizes with the tints.
 *
 * The ONE animation: a subtle pulse on the status dot (the user's request).
 * It is a scoped @keyframes; prefers-reduced-motion turns it OFF (static dot).
 * The dot is aria-hidden — the real "Open to opportunities" text carries meaning.
 *
 * Full-bleed: the <section> breaks out of the parent max-w-[60rem] so the tint
 * field fills the viewport edge-to-edge between nav and footer; the inner column
 * (items-center) centres the profile card. `fill` keeps the footer pinned.
 */

import { Image } from 'astro:assets';
import { SOCIAL_LINKS } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import headshot from '../assets/headshot.jpg';
// bw + art ship with OPAQUE WHITE backgrounds. We use white-knocked-out copies
// (avatar-*-cut.png, transparent bg) so the figure sits directly on the circular
// bg-surface plate and can be duotone-blended POSITIVELY (never inverted) on any
// tint. flat ships on a solid blue square and is handled by its own blend below.
import avatarBw from '../assets/pixel/avatar-bw-cut.png';
import avatarFlat from '../assets/pixel/avatar-flat.png';
import avatarArt from '../assets/pixel/avatar-art-cut.png';
// 'gba' = COLOUR portrait, white-knocked-out + given a Game Boy Advance
// reflective-LCD colour grade (muted/posterized + GBA gamma) at build time
// (see avatar-color-cut.png). Unlike bw/flat/art it is NOT duotone-blended to
// ink — the GBA was a COLOUR handheld, so the figure keeps its colour and the
// "screen" signature (LCD pixel-grid + scanline) is added in scoped CSS below.
import avatarGba from '../assets/pixel/avatar-color-cut.png';

/** Avatar variants. 'headshot' is the production default (the real `/`). The
 *  'bw' | 'flat' | 'art' variants swap in Ashwin's pixel-art portraits for the
 *  comparison pages and are duotone-blended into the active tint. 'gba' is a
 *  COLOUR variant given a Game Boy Advance LCD treatment (kept colour, never
 *  inverted, with a faint LCD pixel-grid/scanline overlay). */
type Avatar = 'headshot' | 'bw' | 'flat' | 'art' | 'gba';

interface Props {
  /**
   * When true the hero stretches to fill the remaining viewport height
   * (flex-1 inside the column <main>) and vertically centres the profile card,
   * so the composition fills the body between nav and footer — keeping the
   * footer pinned to the bottom with no unfilled background.
   */
  fill?: boolean;
  /**
   * Which portrait to show in the profile plate. Defaults to 'headshot' so the
   * production home page is unchanged; the pixel comparison pages pass
   * 'bw' | 'flat' | 'art' to swap in a pixel-art avatar (duotone-blended).
   */
  avatar?: Avatar;
  /**
   * Optional mono caption rendered under the labels row (e.g. "variant: bw") so
   * a reviewer can tell the comparison pages apart. Omitted on the real home.
   */
  caption?: string;
  /** Kept for API parity with the prior Hero so callers stay drop-in. */
  tagline?: string;
  ctaHref?: string;
  ctaLabel?: string;
  badgeText?: string;
}

const { fill = false, avatar = 'headshot', caption } = Astro.props;

/** Map the variant to its source image. Pixel sources render CRISP (no
 *  smoothing) via the scoped `[data-avatar]` CSS below. */
const AVATAR_SRC = {
  headshot,
  bw: avatarBw,
  flat: avatarFlat,
  art: avatarArt,
  gba: avatarGba,
} as const;

const avatarSrc = AVATAR_SRC[avatar];
const isHeadshot = avatar === 'headshot';
// The GBA variant keeps its COLOUR (no duotone ink-blend) and gets the LCD
// screen overlay, so it branches separately from the bw/flat/art duotone path.
const isGba = avatar === 'gba';
---

<!-- ============================================================
     Hero — centered profile card over the site's tint field. The <section>
     breaks out of the parent max-w-[60rem] (.hero-power below) so the
     transparent field fills the viewport edge-to-edge between nav and footer
     (footer pinned via the fill chain). The inner .hero-col restores the
     reading column and centres the card.
     ============================================================ -->
<section
  id="hero"
  class:list={[
    'hero-power relative',
    fill
      ? 'flex-1 flex flex-col justify-center'
      : 'min-h-[78vh] flex flex-col justify-center',
  ]}
  aria-label="Introduction"
>
  <div class="hero-col relative z-10 w-full max-w-[60rem] mx-auto px-6 sm:px-10 py-16">
    <!-- Centered vertical stack: photo → (name → status → labels). -->
    <div class="flex flex-col items-center gap-y-7 text-center">
      <!-- AVATAR — Ashwin's headshot on a duotone surface plate. The circular
           plate + hairline border are preserved; the photo fills the ring via
           object-cover and is framed on the face (it sits in the upper-middle of
           the source frame). A uniform grayscale+contrast (.profile-duotone)
           harmonizes the photo with the strict-duotone tints — NEVER inverted on
           any tint, so it always reads as a normal (non-negative) photo.

           GOLDEN-RATIO SIZING (desktop ≥640px): the plate diameter is tied to
           the rendered width of the hero name by φ. Measured at 1280px the name
           "Ashwin John Chempolil" renders ~453px wide IN SYNE (the display font —
           narrower than the earlier Onest mis-measurement of 477px); the plate is
           sized to 453 / φ ≈ 280px so name_width ≈ 1.618 × diameter — the name
           stays wider than the circle (dominant) while the circle reads large and
           deliberate. Below sm the plate steps down to 13rem so it never crowds a
           375px viewport (where the name wraps); the φ relationship is the
           desktop target. -->

      <div
        class="profile-avatar flex h-52 w-52 sm:h-[280px] sm:w-[280px] items-center justify-center rounded-full border border-border bg-surface p-2"
      >
        {isHeadshot ? (
          <Image
            src={avatarSrc}
            alt="Ashwin John Chempolil"
            width={560}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="profile-duotone h-full w-full rounded-full object-cover"
            style="object-position: 50% 28%;"
          />
        ) : isGba ? (
          /* GBA VARIANT — COLOUR portrait on the surface plate, given a Game Boy
             Advance reflective-LCD look. The colour grade is baked into the PNG
             (muted/posterized + GBA gamma); the recognizable "screen" signature
             — a faint LCD pixel-grid + scanline — is the .gba-screen overlay
             pseudo-element on this wrapper. The image stays CRISP (pixelated) and
             POSITIVE on every tint (never inverted); a theme-aware brightness
             nudge keeps it legible on the dark p1 phosphor plate. */
          <span class="gba-screen relative block h-full w-full overflow-hidden rounded-full">
            <Image
              src={avatarSrc}
              alt="Ashwin John Chempolil — Game Boy Advance pixel-art portrait"
              width={560}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-avatar="gba"
              class="gba-img h-full w-full rounded-full object-cover"
            />
          </span>
        ) : (
          /* PIXEL-ART VARIANT — same circular plate, but the portrait is
             duotone-blended into the active tint and rendered CRISP (pixelated).
             `data-avatar` selects the per-variant treatment in the scoped CSS. */
          <Image
            src={avatarSrc}
            alt="Ashwin John Chempolil — pixel-art portrait"
            width={560}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-avatar={avatar}
            class="pixel-duotone h-full w-full rounded-full object-cover"
          />
        )}
      </div>

      <!-- Intro block — name, status badge, labels row. -->
      <div class="flex flex-col items-center gap-y-4">
        <!-- NAME — display heading, kept at its standard prominent size
             (text-4xl / 44px). It is the φ anchor: the avatar plate above is
             sized to name_width / φ, so this name stays the dominant, wider
             element while the circle scales up to meet it in golden proportion. -->
        <h1 class="font-display text-4xl leading-tight text-primary">
          Ashwin John Chempolil
        </h1>

        <!-- STATUS BADGE — rounded-[3px] (not a pill), duotone surface, pulsing
             ink dot. The dot is decorative (aria-hidden); the text is the label. -->
        <span
          class="status-badge flex flex-row items-center gap-x-3 rounded-[3px] border border-border bg-surface px-4 py-2"
        >
          <span class="status-dot-wrap relative flex h-2 w-2 items-center justify-center" aria-hidden="true">
            <span class="status-pulse absolute inline-flex h-2 w-2 rounded-full bg-accent"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span class="font-mono text-sm font-medium text-primary">Open to opportunities</span>
        </span>

        <!-- LABELS ROW — centered, wrapping: location + LinkedIn. -->
        <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 font-mono text-sm text-secondary">
          <span class="flex flex-row items-center gap-x-2">
            <!-- Location pin — inline svg, forced to ink (text-primary). -->
            <svg
              class="h-5 w-5 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Washington DC</span>
          </span>

          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-row items-center gap-x-2 text-accent transition-colors hover:text-accent-hover"
          >
            <BrandIcon name="linkedin" class="h-5 w-5" />
            <span>Connect on LinkedIn</span>
          </a>
        </div>

        {/* Optional variant caption — mono, dimmed, only on comparison pages. */}
        {caption && (
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-secondary opacity-70">
            {caption}
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================
     Centered profile-card hero — token-driven duotone. Every tint resolves
     via [data-theme] alone; no hardcoded hues.
     ========================================================== */
  .hero-power {
    /* Transparent so the base tint background (painted on <body>) shows
       through the full-bleed hero. */
    background: transparent;
    color: var(--color-primary);

    /* ---- FULL-BLEED BREAK-OUT ----
       The hero lives inside <main class="max-w-[60rem]">, which would clamp
       it to a 960px centred box. Negative inline margins (NOT width:100vw)
       stretch the section symmetrically to both viewport edges relative to the
       parent's box, so it stays centred and never forces horizontal page
       overflow from the scrollbar gutter. html{overflow-x:clip} (global.css)
       absorbs any sub-pixel delta. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* ---- Profile photo duotone treatment ----
     A colour headshot would break the strict-duotone screen, so force it toward
     ink: grayscale removes the hue, contrast/brightness shape it. Recipe mirrors
     ExperienceTimeline's `.neu-duotone`, scoped here.

     UNIFORM across ALL tints (dmg/pocket/p1) — there is deliberately NO per-theme
     invert. The photo must NEVER render as a negative/inverted image on the dark
     (p1) tint; a normal grayscale headshot reads correctly on every tint and fits
     the monochrome aesthetic. */
  .profile-duotone {
    filter: grayscale(1) contrast(1.05) brightness(0.95);
  }

  /* ==========================================================
     PIXEL-ART DUOTONE BLEND (comparison pages only) — POSITIVE, NEVER INVERTED
     ----------------------------------------------------------
     HARD RULE: no `invert()` on ANY tint. The portrait must always read as a
     POSITIVE image (face lighter-than-or-equal-to its real tonal order), never a
     photo-negative. On the dark p1 phosphor tint the figure is tinted toward the
     light green ink and stays legible WITHOUT flipping the face.

     SOURCES (after the white-knockout step):
       • bw  → avatar-bw-cut.png   (grayscale figure on a TRANSPARENT bg)
       • art → avatar-art-cut.png  (colour figure on a TRANSPARENT bg)
       • flat→ avatar-flat.png     (colour figure on an OPAQUE blue square)
     Because bw/art now have a transparent background, the figure sits directly on
     the circular `bg-surface` plate — the blend only has to retint the FIGURE,
     not erase a background.

     HOW THE DUOTONE WORKS (mix-blend-mode against the solid surface plate):
       • LIGHT tints (dmg / pocket, :root + [pocket]):
         grayscale(1) strips hue; mix-blend-mode:multiply darkens the plate by the
         figure's luminance → dark figure pixels print as theme INK on the light
         plate, light pixels (skin/teeth) let the plate show. A normal, positive
         portrait. Transparent bg contributes nothing → bare plate.

       • DARK tint (p1, bright phosphor green on near-black plate):
         grayscale(1) then mix-blend-mode:SCREEN (NOT invert). Screen LIGHTENS the
         near-black plate by the figure's luminance and PRESERVES tonal order
         (brighter source → brighter result), so the lit parts of the face glow as
         phosphor-green ink and the shadows settle into the dark plate — a positive
         portrait, not a negative. A brightness/contrast lift raises mid-tones so
         the figure is clearly visible against #0a160a. No `invert()` anywhere.

     CRISPNESS: image-rendering: pixelated keeps the pixel grid sharp when the
     source is scaled up into the 280px circle (no smoothing/blur).
     ========================================================== */
  .pixel-duotone {
    image-rendering: pixelated;
    /* Light-tint default (dmg / pocket): hue-strip + ink-print via multiply. */
    filter: grayscale(1) contrast(1.12) brightness(1.02);
    mix-blend-mode: multiply;
    opacity: 0.95;
  }

  /* 'flat' = colour portrait on a solid BLUE square (~#2d5b8e). grayscale
     neutralizes the blue to a ~33% mid-grey; under multiply that would print as
     a dark square. Lift brightness hard so the neutralized blue fades up toward
     the surface plate (the square dissolves), while contrast holds the figure's
     darks so the portrait still reads as ink. */
  .pixel-duotone[data-avatar='flat'] {
    filter: grayscale(1) contrast(1.18) brightness(1.35);
  }

  /* 'bw' is already grayscale on a now-TRANSPARENT bg — lightest touch. Under
     multiply only the figure's ink prints onto the plate; the transparent bg
     contributes nothing. No per-variant override beyond a gentle contrast. */
  .pixel-duotone[data-avatar='bw'] {
    filter: grayscale(1) contrast(1.1) brightness(1);
  }

  /* DARK tint (p1): SCREEN, no invert. Screen preserves tonal order so the face
     stays POSITIVE; the brightness lift maps the figure's luminance up into the
     phosphor-green ink range so it is clearly visible on the near-black plate.
     Transparent bg (bw/art) contributes nothing → bare dark plate behind. */
  :global([data-theme='p1']) .pixel-duotone {
    filter: grayscale(1) contrast(1.1) brightness(1.45);
    mix-blend-mode: screen;
    opacity: 0.95;
  }
  /* 'flat' under p1 — opaque neutralized-blue square. Screen (no invert) lifts the
     light figure pixels (skin/teeth) toward bright green ink while the neutralized
     blue settles as a muted dark-green square behind the portrait. Positive. */
  :global([data-theme='p1']) .pixel-duotone[data-avatar='flat'] {
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    mix-blend-mode: screen;
  }

  /* ==========================================================
     GBA SCREEN TREATMENT (comparison page only) — TOKEN-REACTIVE TINT, BLENDED
     ----------------------------------------------------------
     GOAL (user's repeated ask): the avatar must BLEND with the website
     background, not pop as a full-colour cutout. So the GBA portrait is NO
     LONGER rendered in natural colour. Instead it is grayscaled and DUOTONE-
     BLENDED onto the active theme's solid `bg-surface` plate via mix-blend-mode
     — exactly the proven token-reactive mechanism used by `.pixel-duotone`
     above. Its dominant tone therefore RETINTS with the theme:
       • dmg   → olive-toned (figure prints in olive ink #0f380f on #9bbc0f)
       • pocket→ gray-toned  (figure prints in neutral ink #1b1f18 on #c6cbb6)
       • p1    → green-phosphor-toned (figure glows #33ff66 on near-black plate)
     so it reads as part of the colored screen and blends into each background.

     The Game Boy ADVANCE LCD signature is KEPT — `image-rendering: pixelated`
     for crisp pixels and the `.gba-screen::after` pixel-grid + scanline overlay
     — so it is still a GBA-screen portrait, just rendered THROUGH the theme
     palette instead of in raw colour.

     HOW THE DUOTONE WORKS (mix-blend against the solid `bg-surface` plate that
     wraps this image):
       • LIGHT tints (dmg / pocket): grayscale(1) strips the natural colour;
         mix-blend-mode:multiply darkens the plate by the figure's luminance →
         dark pixels print as theme INK on the light plate, light pixels (skin/
         teeth) let the plate show. Positive, blended, theme-toned.
       • DARK tint (p1): grayscale(1) then mix-blend-mode:SCREEN (NOT invert).
         Screen LIGHTENS the near-black plate by the figure's luminance and
         PRESERVES tonal order, so the lit face glows phosphor-green and shadows
         settle into the dark plate — a positive portrait, never a negative.

     HARD RULE: NO invert() on ANY tint.

       • .gba-screen::after — the faint LCD PIXEL-GRID + SCANLINE overlay.
         Two thin repeating-linear-gradients draw the vertical + horizontal
         cell gridlines of an LCD matrix (~4px cells); a third, softer
         horizontal band adds a subtle scanline cast. mix-blend-mode:multiply
         lets the grid darken the portrait beneath without hiding it. Very low
         opacity so it reads as "screen", not noise. pointer-events:none.
     ========================================================== */
  .gba-img {
    image-rendering: pixelated;
    /* Light-tint default (dmg / pocket): strip natural colour, then duotone-
       print onto the themed plate via multiply so the figure tone === theme ink.
       This is what makes the avatar BLEND with the active background instead of
       popping in full colour. */
    filter: grayscale(1) contrast(1.12) brightness(1.04);
    mix-blend-mode: multiply;
    opacity: 0.96;
  }

  .gba-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    pointer-events: none;
    /* LCD pixel-grid (vertical + horizontal cell lines) + soft scanline cast.
       ~4px cells read as a screen matrix without dominating the portrait. */
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(0, 0, 0, 0.16) 0,
        rgba(0, 0, 0, 0.16) 1px,
        transparent 1px,
        transparent 4px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.16) 0,
        rgba(0, 0, 0, 0.16) 1px,
        transparent 1px,
        transparent 4px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.05) 0,
        rgba(0, 0, 0, 0.05) 2px,
        transparent 2px,
        transparent 4px
      );
    mix-blend-mode: multiply;
    opacity: 0.5;
  }

  /* DARK tint (p1) — SCREEN, no invert. Screen preserves tonal order so the
     figure stays POSITIVE; the brightness lift maps the figure's luminance up
     into the phosphor-green ink range so it glows on the near-black plate and
     BLENDS into the dark screen rather than popping in colour. */
  :global([data-theme='p1']) .gba-img {
    filter: grayscale(1) contrast(1.1) brightness(1.45);
    mix-blend-mode: screen;
    opacity: 0.96;
  }
  :global([data-theme='p1']) .gba-screen::after {
    /* On a dark plate a darkening grid is nearly invisible and would muddy the
       figure — switch to a faint LIGHT grid via screen so the LCD matrix still
       reads as a subtle screen texture. Still no invert of the portrait. */
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(255, 255, 255, 0.1) 0,
        rgba(255, 255, 255, 0.1) 1px,
        transparent 1px,
        transparent 4px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.1) 0,
        rgba(255, 255, 255, 0.1) 1px,
        transparent 1px,
        transparent 4px
      );
    mix-blend-mode: screen;
    opacity: 0.45;
  }

  /* ---- Status dot pulse — the ONE animation (user request) ----
     A subtle expanding/fading ring behind the solid ink dot. Tasteful, low
     amplitude. The whole dot cluster is aria-hidden; the text carries meaning. */
  .status-pulse {
    transform-origin: center;
    animation: status-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes status-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Reduced motion — pulse OFF, static ink dot only. */
  @media (prefers-reduced-motion: reduce) {
    .status-pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>
