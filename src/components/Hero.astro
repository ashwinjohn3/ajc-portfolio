---
/**
 * Hero.astro — faithful mainline hero, static.
 *
 * Reproduces the mainline (app/page.tsx) hero VERBATIM — two left-aligned
 * lines, nothing else:
 *
 *   1. "Hi, I'm Ashwin."                                  (semibold, ~1.5rem, primary ink)
 *   2. "I'm a software engineer based in Washington, DC 🌸." (muted ink, max-width ~520px)
 *
 * NO entrance animation, NO scanline, NO phosphor bloom — both lines are
 * fully visible immediately (real text, a11y-first). The field itself is the
 * site-wide tint background (the hero stays transparent so the animated dot
 * field shows through); no grid, no spotlight, no terminal chrome.
 *
 * STRICT DUOTONE — every visual reads only the tint tokens (--color-primary /
 * --color-secondary), so all 6 analog tints resolve via [data-theme] alone.
 * No hardcoded hues.
 *
 * Props mirror the prior Hero so callers (index.astro) keep working.
 */

import { BIO } from '../data/site';

interface Props {
  tagline?: string;
  /** Kept for API parity with the prior Hero so callers (index.astro) keep working. */
  ctaHref?: string;
  ctaLabel?: string;
  badgeText?: string;
  /**
   * When true the hero stretches to fill the remaining viewport height
   * (flex-1 inside a column <main>) and vertically centers its content, so
   * the composition fills the body between nav and footer — keeping the
   * footer pinned to the bottom with no unfilled background.
   */
  fill?: boolean;
}

const {
  tagline = BIO.tagline,
  fill = false,
} = Astro.props;
---

<!-- ============================================================
     Hero — two static lines over the site's tint field. The <section>
     breaks out of the parent max-w-[60rem] (.hero-power below) so the
     transparent field fills the viewport edge-to-edge between nav and
     footer (keeping the footer pinned via the fill chain) and the animated
     dot field shows through. The inner .hero-col restores the 60rem reading
     column so the two lines align to the same grid edge as the other
     pages/cards.
     ============================================================ -->
<section
  id="hero"
  class:list={[
    'hero-power relative',
    fill
      ? 'flex-1 flex flex-col justify-center'
      : 'min-h-[78vh] flex flex-col justify-center',
  ]}
  aria-label="Introduction"
>
  <!-- Reading column — restores the 60rem grid the text aligns to -->
  <div class="hero-col relative z-10 w-full max-w-[60rem] mx-auto px-6 sm:px-10 pt-16 pb-12">
    <p class="hero-intro font-body font-semibold text-primary">{BIO.intro}</p>
    <p class="hero-sub text-secondary">{tagline}</p>
  </div>
</section>

<style>
  /* ==========================================================
     FAITHFUL HERO — static, token-driven duotone. Every tint
     resolves via [data-theme] alone. Both lines are fully visible
     by default; there is no entrance animation, so reduced-motion
     is trivially satisfied.
     ========================================================== */
  .hero-power {
    /* Transparent so the site-wide animated dot field (#dot-field) shows
       THROUGH the hero. The base tint color is painted on <html>/<body>, so
       the field is unchanged — only the hero stays see-through. */
    background: transparent;
    color: var(--color-primary);

    /* ---- FULL-BLEED BREAK-OUT ----
       The hero lives inside <main class="max-w-[60rem]">, which would clamp
       the field to a 960px centered box. Break out so the field fills the
       viewport edge-to-edge; the inner .hero-col restores the 60rem reading
       column for the text.

       Negative inline margins (NOT width:100vw) stretch the section
       symmetrically to both viewport edges relative to the parent's box, so
       it stays centered and never forces horizontal page overflow from the
       scrollbar gutter. html{overflow-x:clip} (global.css) absorbs any
       sub-pixel delta. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* ---- Intro line — "Hi, I'm Ashwin." (mainline: 1.5rem / 600 / primary ink). ---- */
  .hero-intro {
    font-size: 1.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  /* ---- Subline — muted ink, the body font, max-width ~520px (mainline). ---- */
  .hero-sub {
    max-width: 520px;
    line-height: 1.55;
  }
</style>
