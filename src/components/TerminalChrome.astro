---
/**
 * TerminalChrome.astro — ONE reusable terminal window bar.
 *
 * The hero used to read as two mismatched "terminal bars" (a loose boot-log
 * strip up top, a loose meta/coords strip at the bottom) at different sizes.
 * This is the single source of truth for that chrome: the SAME height, padding,
 * dot treatment and title type wherever a bar appears, so the top title bar and
 * the bottom status bar read as one coherent window — DRY, not copy-paste.
 *
 * variant:
 *   "title"  — top window bar: three monochrome dots + a left title slot.
 *   "status" — bottom status bar: a left status slot, no dots (or a single
 *              ink square caret), reading as the same system as the title bar.
 *
 * STRICT DUOTONE — reads only the tint tokens (--color-surface / border /
 * secondary / primary), so all six analog tints resolve via [data-theme] alone.
 * No third hue, no emoji, no colored traffic lights (dots are monochrome ink).
 *
 * Decorative: aria-hidden by default (the bar is window furniture, not content).
 * Pass `decorative={false}` if a bar ever needs to expose its text to AT.
 */
interface Props {
  /** Which bar this is — drives border side + caret, NOT sizing (sizing shared). */
  variant?: 'title' | 'status';
  /** Window dots on the left (title bar convention). */
  dots?: boolean;
  /** Mark the whole bar decorative for assistive tech (default true). */
  decorative?: boolean;
  /** Extra classes for the bar element (e.g. animation hook for the motion pass). */
  class?: string;
}

const {
  variant = 'title',
  dots = variant === 'title',
  decorative = true,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['term-bar', `term-bar--${variant}`, className]}
  aria-hidden={decorative ? 'true' : undefined}
>
  {dots && (
    <span class="term-dots" aria-hidden="true">
      <span class="term-dot"></span>
      <span class="term-dot"></span>
      <span class="term-dot"></span>
    </span>
  )}
  {variant === 'status' && <span class="term-caret" aria-hidden="true"></span>}
  <span class="term-label font-mono">
    <slot />
  </span>
</div>

<style>
  /* ==========================================================
     SHARED SIZING TOKENS — the single source of truth. Both the
     title bar and the status bar inherit these, so they are
     pixel-identical in height/padding/dot/type. Change once here.
     ========================================================== */
  .term-bar {
    --term-h: 2.25rem;          /* shared bar height */
    --term-pad-x: 0.85rem;      /* shared horizontal padding */
    --term-gap: 0.5rem;         /* shared dot/label gap */
    --term-dot: 0.62rem;        /* shared dot diameter */
    --term-fs: 0.72rem;         /* shared label font-size */

    display: flex;
    align-items: center;
    gap: var(--term-gap);
    height: var(--term-h);
    min-height: var(--term-h);
    padding-inline: var(--term-pad-x);
    background: color-mix(in srgb, var(--color-surface) 92%, var(--color-primary));
    color: var(--color-secondary);
    user-select: none;
  }

  /* Border treatment distinguishes top vs bottom WITHOUT changing sizing. */
  .term-bar--title {
    border-bottom: 1px solid var(--color-border);
  }
  .term-bar--status {
    border-top: 1px solid var(--color-border);
    justify-content: flex-start;
  }

  /* ---- Monochrome window dots (no traffic-light hues — duotone law) ---- */
  .term-dots {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    margin-right: 0.3rem;
  }
  .term-dot {
    width: var(--term-dot);
    height: var(--term-dot);
    border-radius: 50%;
    /* graded ink fill so three dots read as a cluster, still single-hue */
    background: var(--color-secondary);
  }
  .term-dot:nth-child(1) { opacity: 0.9; }
  .term-dot:nth-child(2) { opacity: 0.62; }
  .term-dot:nth-child(3) { opacity: 0.4; }

  /* ---- Status caret — a blinking ink square, same square the strap uses ---- */
  .term-caret {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--color-primary);
    display: inline-block;
    flex: 0 0 auto;
    animation: term-caret-blink 1.2s step-end infinite;
  }
  @keyframes term-caret-blink { 50% { opacity: 0; } }

  /* ---- Shared label ----
     min-width:0 lets the label shrink below its content size inside the flex
     bar so the ellipsis actually engages on narrow viewports instead of the
     nowrap text forcing the bar (and the page) wider than the screen. */
  .term-label {
    min-width: 0;
    flex: 1 1 auto;
    font-size: var(--term-fs);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .term-caret { animation: none; }
  }
</style>
