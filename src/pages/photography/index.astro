---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageSection from '../../components/PageSection.astro'
import { SITE_NAME } from '../../data/site'

await getCollection('photography')
---

<BaseLayout title={`Photography — ${SITE_NAME}`}>
  <PageSection label="photography" activePath="/photography">
    <p class="max-w-2xl text-[1.02rem] leading-8 text-ink-muted dark:text-night-muted">
      Photo series live as Markdown-backed entries with remotely hosted images, so the gallery stays lightweight while each shoot can grow into its own page.
    </p>
    <div class="mt-12 max-w-2xl border-t border-rule pt-8 dark:border-night-rule">
      <p class="kicker">developing</p>
      <p class="mt-4 font-editorial text-[clamp(1.9rem,4vw,3.2rem)] leading-[1.02] tracking-[-0.03em] text-ink dark:text-night-ink">
        The public gallery is still taking shape.
      </p>
      <p class="mt-4 text-[0.98rem] leading-8 text-ink-muted dark:text-night-muted">
        The intent is to keep it quiet, selective, and more like a set of field notes than an endless stream.
      </p>
    </div>
  </PageSection>
</BaseLayout>
