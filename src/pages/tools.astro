---
/**
 * tools.astro
 * USER-FIX-1 — Dedicated Tools & Setup page
 *
 * Layout: Fragment Mono page header + UsesSection component.
 * Pattern mirrors work.astro exactly.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import UsesSection from '../components/UsesSection.astro';
import { createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Tools')}
  description="Tools, hardware, and software setup — the gear and software Ashwin uses daily."
>
  <PageHeader label="tools & setup" pb="pb-2" />

  <!-- Full tools section — self-contained, reads from uses content collection -->
  <UsesSection />
</BaseLayout>
