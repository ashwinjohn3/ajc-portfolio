---
/**
 * projects/[...path].astro
 * U11 — /projects page (feature-flag gated)
 *
 * STATIC-MODE FLAG GATING (Astro `output: 'static'`):
 * A flat, non-dynamic page (projects.astro) ALWAYS emits an HTML file in dist/,
 * even when its frontmatter returns `new Response(null, {status: 404})` — that
 * Response is rendered to a static 404-bodied HTML file, so the route still
 * ships. The only reliable way to suppress a page from the static build is a
 * dynamic route whose getStaticPaths() returns an empty array: Astro then emits
 * zero HTML for it.
 *
 * When PUBLIC_SHOW_PROJECTS is not "true" (the default):
 *   getStaticPaths() returns [] → no /projects/* HTML in dist/.
 * When enabled:
 *   returns a single { params: { path: undefined } } → emits /projects/index.html
 *   at the bare /projects URL (rest param `undefined` = the top-level route).
 *
 * Nav link is also hidden by Nav.astro when the flag is off (U5).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { isEnabled } from '../../lib/flags';
import { createPageTitle } from '../../data/site';

export function getStaticPaths() {
  // isEnabled reads FEATURE_FLAGS (import.meta.env.PUBLIC_*), resolved at build time.
  return isEnabled('projects') ? [{ params: { path: undefined } }] : [];
}
---

<BaseLayout
  title={createPageTitle('Projects')}
  description="Projects by Ashwin John Chempolil."
>
  <PageHeader label="projects" labelClass="mb-6">
    <p class="text-secondary">
      Coming soon.
    </p>
  </PageHeader>
</BaseLayout>
