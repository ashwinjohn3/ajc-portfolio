---
import { getCollection, render } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
---

<ContentLayout title={`${project.data.title} — Projects`} label="projects" activePath="/projects" entry={project}>
  <p class="content-meta">{project.data.year}</p>
  <p class="content-meta">{project.data.summary}</p>
  <div class="detail-group">
    {project.data.tags.map((tag) => (
      <span class="detail-chip">
        {tag}
      </span>
    ))}
  </div>
  <div class="quiet-links">
    {project.data.externalUrl && (
      <a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" class="quiet-link">
        Visit project
      </a>
    )}
    {project.data.repoUrl && (
      <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="quiet-link">
        View source
      </a>
    )}
  </div>
  <div class="detail-prose mt-5">
    <Content />
  </div>
</ContentLayout>
