---
/**
 * variant-b.astro
 * U10 — Home Variant B (lean front page, no work timeline)
 *
 * Layout: Hero → "see my work" link → Uses/Tools → Contact teaser
 * The full work timeline lives at /work.
 * At user review (U15), if this variant wins it is renamed to index.astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import UsesSection from '../components/UsesSection.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import Section from '../components/Section.astro';
import { BIO, createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Home — Variant B')}
  description="Software engineer based in Washington, DC. Building distributed systems and cloud infrastructure at AWS."
>
  <!-- Hero — identical to Variant A; "Get in touch" CTA points to /contact -->
  <Hero
    greeting={BIO.greeting}
    tagline={BIO.tagline}
    ctaHref="/contact"
    ctaLabel="Get in touch"
  />

  <!-- "See my work" bridge link — terracotta accent, Space Mono, leads to /work -->
  <div class="w-full max-w-[60rem] mx-auto px-6 sm:px-10 pb-4">
    <a
      href="/work"
      class="inline-flex items-center gap-1.5 font-mono text-sm text-accent hover:text-accent-hover transition-colors duration-200"
    >
      [see my work]
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Uses / Tools — self-contained, reads from uses content collection -->
  <UsesSection />

  <!-- Contact teaser — minimal, no duplicate of /contact page -->
  <Section id="contact" label="contact">
    <div class="flex flex-col gap-4">
      <p class="text-primary font-sans leading-relaxed">
        Want to work together or just say hello? Reach out.
      </p>
      <p class="text-primary font-sans">
        <ObfuscatedEmail label="[email]" class="text-accent hover:text-accent-hover transition-colors font-mono" />
      </p>
    </div>
  </Section>
</BaseLayout>
