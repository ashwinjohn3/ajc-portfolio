---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageSection from '../components/PageSection.astro'
import { EXPERIENCE, SITE_NAME } from '../data/site'
---

<BaseLayout title={`Work — ${SITE_NAME}`}>
  <PageSection label="work" activePath="/work">
    <div class="max-w-2xl">
      <p class="body-copy">
        A short ledger of the places where I&apos;ve learned how to build, ship, and sharpen judgment over time.
      </p>
    </div>
    <div class="mt-12 border-y border-rule dark:border-night-rule">
      {EXPERIENCE.map((row) => (
        <div class="grid gap-3 border-b border-rule/80 py-5 last:border-b-0 dark:border-night-rule md:grid-cols-[minmax(0,1fr)_auto] md:items-baseline md:gap-6">
          <div class="space-y-1">
            <div class="font-editorial text-[1.25rem] leading-tight tracking-[-0.02em] text-ink dark:text-night-ink">{row.title}</div>
            <div class="font-mono text-[0.72rem] uppercase tracking-[0.14em] text-ink-muted dark:text-night-muted">{row.sub}</div>
          </div>
          <div class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-ink-faint dark:text-night-faint">{row.year}</div>
        </div>
      ))}
    </div>
  </PageSection>
</BaseLayout>
