---
/**
 * pixel-art.astro — COMPARISON PAGE (not linked from nav).
 * Same home profile card, but the headshot is swapped for the colour pixel-art
 * portrait on a transparent background (avatar-art.png), duotone-blended into
 * the active tint so the transparent areas reveal the surface plate.
 * The real `/` is unchanged. Pending Ashwin's pick of variant.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Pixel Art')}
  description="Avatar comparison page — transparent pixel-art variant."
  fillViewport
>
  <Hero fill avatar="art" caption="variant: art" />
</BaseLayout>
