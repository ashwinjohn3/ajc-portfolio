---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageSection from '../components/PageSection.astro'
import SocialIcons from '../components/SocialIcons.astro'
import { EMAIL, SITE_NAME, SOCIAL_LINKS } from '../data/site'
---

<BaseLayout title={`Contact — ${SITE_NAME}`}>
  <PageSection label="contact" activePath="/contact">
    <p class="section-copy">Open to interesting conversations. Say hello.</p>
    <div class="icon-links">
      <a
        href={`mailto:${EMAIL}`}
        aria-label="Email"
        class="icon-link"
      >
        <SocialIcons name="mail" size={18} className="shrink-0" />
      </a>
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="icon-link"
      >
        <SocialIcons name="github" size={15} className="shrink-0" />
      </a>
      <a
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="icon-link"
      >
        <SocialIcons name="linkedin" size={15} className="shrink-0" />
      </a>
    </div>
  </PageSection>
</BaseLayout>
