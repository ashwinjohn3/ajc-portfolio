---
/**
 * contact.astro
 * U11 — /contact page
 *
 * Displays ObfuscatedEmail (zero plaintext email in built HTML) + GitHub + LinkedIn.
 * Social links from src/data/site.ts — no hardcoded URLs here.
 * SECURITY: grep dist/ for "ashwinjohn3" or "@gmail" must return zero.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { SOCIAL_LINKS, createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Contact')}
  description="Get in touch with Ashwin John Chempolil."
>
  <div class="w-full max-w-[60rem] mx-auto px-6 sm:px-10 pt-20 pb-16 sm:pt-28">
    <!-- Section label: Fragment Mono, consistent with other page headers -->
    <p class="font-mono text-xs uppercase tracking-widest text-secondary mb-6">contact</p>

    <p class="text-secondary mb-8">
      Open to interesting conversations. Say hello.
    </p>

    <!-- Contact links row: email + socials -->
    <div class="flex flex-wrap gap-6 items-center">
      <!-- Email: decoded client-side only — no plaintext in HTML -->
      <ObfuscatedEmail label="[email]" />

      <!-- GitHub -->
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="inline-flex items-center text-accent hover:text-accent-hover transition-colors duration-200"
      >
        <BrandIcon name="github" title="GitHub" class="w-5 h-5" />
      </a>

      <!-- LinkedIn -->
      <a
        href={SOCIAL_LINKS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="inline-flex items-center text-accent hover:text-accent-hover transition-colors duration-200"
      >
        <BrandIcon name="linkedin" title="LinkedIn" class="w-5 h-5" />
      </a>
    </div>
  </div>
</BaseLayout>
