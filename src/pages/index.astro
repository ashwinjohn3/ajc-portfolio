---
/**
 * index.astro
 * Lean home — hero only, NO work timeline (the timeline lives at /work).
 *
 * Layout: full-bleed Hero stretched to fill the viewport between nav and
 * footer (fillViewport + Hero fill). The top nav already links /work, so the
 * home carries no separate bridge link. Absorbs the former variant-b
 * composition; variant-b.astro is gone.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { BIO, createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Home')}
  description="Software engineer based in Washington, DC. Building distributed systems and cloud infrastructure at AWS."
  fillViewport
>
  <!-- Hero — full-bleed, fills remaining viewport height; centered axis stays centered -->
  <Hero
    tagline={BIO.tagline}
    ctaHref="/contact"
    ctaLabel="Get in touch"
    fill
  />
</BaseLayout>
