---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { BIO, createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Home')}
  description="Software engineer based in Washington, DC. Building distributed systems and cloud infrastructure at AWS."
>
  <Hero
    greeting={BIO.greeting}
    tagline={BIO.tagline}
    ctaHref="/contact"
    ctaLabel="Get in touch"
  />

  <ExperienceTimeline />
</BaseLayout>
