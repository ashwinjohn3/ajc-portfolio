---
/**
 * pixel-flat.astro — COMPARISON PAGE (not linked from nav).
 * Same home profile card, but the headshot is swapped for the colour pixel-art
 * portrait that ships on a flat BLUE square (avatar-flat.png). The duotone
 * treatment neutralizes the blue so the square blends into the plate/screen.
 * The real `/` is unchanged. Pending Ashwin's pick of variant.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { createPageTitle } from '../data/site';
---

<BaseLayout
  title={createPageTitle('Pixel Flat')}
  description="Avatar comparison page — flat-background pixel-art variant."
  fillViewport
>
  <Hero fill avatar="flat" caption="variant: flat" />
</BaseLayout>
