# Feature flags — copy this file to .env and set values as needed.
# All are OFF by default. Set to "true" to enable the route and its nav link.

# Enables /projects route and [projects] nav link
PUBLIC_SHOW_PROJECTS=false

# Enables /photography route and [photography] nav link
PUBLIC_SHOW_PHOTOGRAPHY=false

# Enables /tools route and [tools] nav link
PUBLIC_SHOW_TOOLS=false
